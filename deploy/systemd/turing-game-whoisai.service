[Unit]
Description=Turing Game - WhoisAI Module (猜AI模式)
Documentation=https://docs.xiaofengqwq.com/%E5%9B%BE%E7%81%B5%E6%B5%8B%E8%AF%95
PartOf=turing-game.target
After=network.target redis.service
Wants=redis.service

[Service]
Type=simple
User=xiaofengqwq
Group=xiaofengqwq
WorkingDirectory=__PROJECT_DIR__
ExecStart=/usr/bin/php __PROJECT_DIR__/cli.php server:start whoisai
ExecStop=/bin/kill -SIGTERM $MAINPID
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target